      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "After this section\n\n- You will know the difference between definite and indefinite iteration \n- You will know how a Python `for` loop works\n- You will be able to use a `for` loop to iterate through lists and strings"
      },
      "translation": {
        "language": "vi",
        "content": ""
      },
      "metadata": {

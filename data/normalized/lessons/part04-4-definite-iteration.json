      "type": "code",
      "order": 24,
      "source_hash": "fc3ef44c3e513c00482de5efe95899b523ed6b8aee90bf0b3e32049d87fbd860",
      "translation_status": "not_applicable",
      "original": {
        "language": "code",
        "content": "for i in range(5):\n    print(i)"
      },
      "translation": {
        "language": "code",

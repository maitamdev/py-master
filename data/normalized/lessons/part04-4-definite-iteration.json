    {
      "id": "blk-part04-4-definite-iteration-0002",
      "type": "paragraph",
      "order": 2,
      "source_hash": "3e8b742d0a2a3c05570d5816dddf2a70902474e0bda0015fafbf728c096f8e86",
      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "You can use a `while` loop to go through the items in a list, just like we used while loops to go through strings. The following program prints out the items in the list, each on a separate line:"
      },
      "translation": {
        "language": "vi",
        "content": ""
      },
      "metadata": {}
    },
    {
      "id": "blk-part04-4-definite-iteration-0003",
      "type": "code",
      "order": 3,
      "source_hash": "03a09f4e653ed496cc581d6ce57982f2bd716a0356d956e451ce70fad99f0df0",
      "translation_status": "not_applicable",
      "original": {
        "language": "code",
        "content": "my_list = [3, 2, 4, 5, 2]\n\nindex = 0\nwhile index < len(my_list):\n    print(my_list[index])\n    index += 1"
      },
      "translation": {
        "language": "code",
        "content": "my_list = [3, 2, 4, 5, 2]\n\nindex = 0\nwhile index < len(my_list):\n    print(my_list[index])\n    index += 1"
      },
      "metadata": {
        "language": "python",
        "code_hash": "03a09f4e653ed496cc581d6ce57982f2bd716a0356d956e451ce70fad99f0df0",
        "length_lines": 6
      }
    },

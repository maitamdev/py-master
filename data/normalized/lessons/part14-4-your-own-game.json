      "order": 6,
      "source_hash": "6d268f669e287bd20cccc01d86d3497525d0b912be296d205d9839e0bd62bcaf",
      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "Submitting the game"
      },
      "translation": {
        "language": "vi",
        "content": ""

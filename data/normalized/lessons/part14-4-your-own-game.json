    {
      "id": "blk-part14-4-your-own-game-0016",
      "type": "paragraph",
      "order": 16,
      "source_hash": "ed5961efc92ccca7612fdc70edce16fba9416de1bbbaa7f535f8b2e714cde3f7",
      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "The goal of this part is to build a small, working game. As this part contains only a single task, *you get points for effort*. Please submit your game even if you can't get it to work quite the way you wanted to."
      },
      "translation": {
        "language": "vi",
        "content": ""
      },
      "metadata": {}
    },
    {
      "id": "blk-part14-4-your-own-game-0017",
      "type": "paragraph",
      "order": 17,
      "source_hash": "94228c39349bb6df0efc22f7318892a9fc549deed4e95feb1c542e481615f4fb",
      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "If your game doesn't work the way you intended, please include comments in your code about how it _should_ work, or any features you think are missing but did not manage to implement."
      },
      "translation": {
        "language": "vi",
        "content": ""
      },
      "metadata": {}
    },
    {
      "id": "blk-part14-4-your-own-game-0018",
      "type": "paragraph",
      "order": 18,
      "source_hash": "5d20065476e4dcfd03bf0ffc854c13bf57e9a99bbfcdcb97acd7af73720eb363",
      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "If a game you are reviewing is incomplete or doesn't work quite right, please include comments about what you think could have been done to make it work, if at all possible."
      },
      "translation": {
        "language": "vi",
        "content": ""
      },
      "metadata": {}
    },
    {
      "id": "blk-part14-4-your-own-game-0019",
      "type": "heading",
      "order": 19,
      "source_hash": "39d7253e616ec45b3726a7d185cb0c55d0e9dcb1d3c15f088b060980fdc30fc0",
      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "Some game ideas"

        "level": 2
      }
    },
    {
      "id": "blk-part14-4-your-own-game-0020",
      "type": "paragraph",
      "order": 20,
      "source_hash": "418a85e55d1958f829ac5773362c8bf875768d86506c644dfecf5208c1e668f1",
      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "It is completely up to you what your game will be about, but here are some ideas to help you get started. Remember the material in part 13; those examples can help you work on your ideas, too."
      },
      "translation": {
        "language": "vi",
        "content": ""
      },
      "metadata": {}
    },
    {
      "id": "blk-part14-4-your-own-game-0021",
      "type": "heading",
      "order": 21,
      "source_hash": "388431600227a0a1051296457596397e1a25f62c928180f2fd4d71bcb79aa9e7",
      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "A collecting game"
      },
      "translation": {
        "language": "vi",
        "content": ""
      },
      "metadata": {
        "level": 3
      }
    },
    {
      "id": "blk-part14-4-your-own-game-0022",
      "type": "list",
      "order": 22,
      "source_hash": "b90b9d2d8d6fa076642720f27dcc037e0aa54202d843e9e1e3ff4639f16e5813",
      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "* The player moves the robot with the arrow keys.\n* A coin appears in a random location on the screen. When the robot reaches it, the coin moves to a new location.\n* There are also monsters on the screen, and the robot must avoid them."
      },
      "translation": {
        "language": "vi",
        "content": ""
      },
      "metadata": {}
    },
    {
      "id": "blk-part14-4-your-own-game-0023",
      "type": "heading",
      "order": 23,
      "source_hash": "7db38f3b8efcae6d6a958402bf3f7a495c5e873aab6f1281c513aaef1943d663",
      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "A rain of coins"
      },
      "translation": {
        "language": "vi",
        "content": ""
      },
      "metadata": {
        "level": 3
      }
    },
    {
      "id": "blk-part14-4-your-own-game-0024",
      "type": "list",
      "order": 24,
      "source_hash": "382c3be15f2fc1d842d6b84c323fcc2420c1452568ffa568f4f79e6b213000a0",
      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "* The player moves the robot to the left and right along the bottom of the screen.\n* Coins rain from the sky. The robot must collect these.\n* Also monsters rain from the sky. The robot must avoid these."
      },
      "translation": {
        "language": "vi",
        "content": ""
      },
      "metadata": {}
    },
    {
      "id": "blk-part14-4-your-own-game-0025",
      "type": "heading",
      "order": 25,
      "source_hash": "87c3c75c13790d04fb0b74a3e891bcc236659d5262cd892a6841078eaa6ae799",
      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "Peer review"

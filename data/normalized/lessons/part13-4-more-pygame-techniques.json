    {
      "id": "blk-part13-4-more-pygame-techniques-0011",
      "type": "paragraph",
      "order": 11,
      "source_hash": "f0ef99674dd69a5ee9f1fc1bc5365c98e84b2e9191b298c0392f6f66db4d4982",
      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "Text in pygame is drawn in two steps: first we create an image containing the desired text, and then this image is drawn on the screen. It works like this:"
      },
      "translation": {
        "language": "vi",
        "content": ""
      },
      "metadata": {}
    },
    {
      "id": "blk-part13-4-more-pygame-techniques-0012",
      "type": "code",
      "order": 12,
      "source_hash": "8ce6fb8fc4ffa1662b82ffa2fcedeedccf47ebffff1a47e60600df252ff1925b",
      "translation_status": "not_applicable",
      "original": {
        "language": "code",
        "content": "import pygame\n\npygame.init()\ndisplay = pygame.display.set_mode((640, 480))\ndisplay.fill((0, 0, 0))\n\ngame_font = pygame.font.SysFont(\"Arial\", 24)\ntext = game_font.render(\"Moikka!\", True, (255, 0, 0))\ndisplay.blit(text, (100, 50))\npygame.display.flip()\n\nwhile True:\n    for event in pygame.event.get():\n        if event.type == pygame.QUIT:\n            exit()"
      },
      "translation": {
        "language": "code",
        "content": "import pygame\n\npygame.init()\ndisplay = pygame.display.set_mode((640, 480))\ndisplay.fill((0, 0, 0))\n\ngame_font = pygame.font.SysFont(\"Arial\", 24)\ntext = game_font.render(\"Moikka!\", True, (255, 0, 0))\ndisplay.blit(text, (100, 50))\npygame.display.flip()\n\nwhile True:\n    for event in pygame.event.get():\n        if event.type == pygame.QUIT:\n            exit()"
      },
      "metadata": {
        "language": "python",
        "code_hash": "8ce6fb8fc4ffa1662b82ffa2fcedeedccf47ebffff1a47e60600df252ff1925b",
        "length_lines": 15
      }
    },

    {
      "id": "blk-part13-4-more-pygame-techniques-0007",
      "type": "code",
      "order": 7,
      "source_hash": "106b1897ab48b5f7b346227a0f33a776285c15d93031d431c42704c9b166e79f",
      "translation_status": "not_applicable",
      "original": {
        "language": "code",
        "content": "import pygame\n\npygame.init()\ndisplay = pygame.display.set_mode((640, 480))\ndisplay.fill((0, 0, 0))\n\npygame.draw.rect(display, (0, 255, 0), (50, 100, 200, 250))\npygame.draw.circle(display, (255, 0, 0), (200, 150), 40)\npygame.draw.line(display, (0, 0, 255), (80, 120), (300, 160), 2)\n\npygame.display.flip()\n\nwhile True:\n    for event in pygame.event.get():\n        if event.type == pygame.QUIT:\n            exit()"
      },
      "translation": {
        "language": "code",
        "content": "import pygame\n\npygame.init()\ndisplay = pygame.display.set_mode((640, 480))\ndisplay.fill((0, 0, 0))\n\npygame.draw.rect(display, (0, 255, 0), (50, 100, 200, 250))\npygame.draw.circle(display, (255, 0, 0), (200, 150), 40)\npygame.draw.line(display, (0, 0, 255), (80, 120), (300, 160), 2)\n\npygame.display.flip()\n\nwhile True:\n    for event in pygame.event.get():\n        if event.type == pygame.QUIT:\n            exit()"
      },
      "metadata": {
        "language": "python",
        "code_hash": "106b1897ab48b5f7b346227a0f33a776285c15d93031d431c42704c9b166e79f",

        "language": "vi",
        "content": ""
      },
      "metadata": {}
    },
    {
      "id": "blk-part13-4-more-pygame-techniques-0016",
      "type": "paragraph",
      "order": 16,
      "source_hash": "2b96d15bf76547a2dfb277301446fe4f16a59a5a6da3e9177e2af06f618ac72b",
      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "NB: different systems will have different fonts available. If the system this program is exeuted on doesn't have the Arial font, even though Arial is a very common font available on most systems, the default system font is used instead. If you need to have a specific font available for your game, you can include the font file in the game directory and specify its location for the `pygame.font.Font` method."
      },
      "translation": {
        "language": "vi",
        "content": ""
      },
      "metadata": {}

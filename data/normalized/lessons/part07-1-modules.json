      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "Sometimes a handy shortcut is to import _all_ the contents of a module with the star notation:"
      },
      "translation": {
        "language": "vi",
        "content": ""
      },
      "metadata": {}
    },
    {
      "id": "blk-part07-1-modules-0027",
      "type": "code",
      "order": 27,
      "source_hash": "9b88c5d8f9823baa1101d7351fb36f481807478b9f32a917a539a01f749c2a51",
      "translation_status": "not_applicable",
      "original": {
        "language": "code",
        "content": "from math import *\n\nprint(sqrt(5))\nprint(log(5,2))"
      },
      "translation": {
        "language": "code",
        "content": "from math import *\n\nprint(sqrt(5))\nprint(log(5,2))"
      },
      "metadata": {
        "language": "python",
        "code_hash": "9b88c5d8f9823baa1101d7351fb36f481807478b9f32a917a539a01f749c2a51",
        "length_lines": 4
      }
    },
    {

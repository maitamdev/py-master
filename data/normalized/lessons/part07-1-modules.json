      "metadata": {}
    },
    {
      "id": "blk-part07-1-modules-0014",
      "type": "paragraph",
      "order": 14,
      "source_hash": "728151993be31f54a023f03aee95de99b048457ee581ca7d24e96132719911fc",
      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "When you are done debugging, remember to remove the `breakpoint` commands from your code!"

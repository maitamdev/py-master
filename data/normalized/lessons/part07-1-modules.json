      "source_hash": "db2af4d38ec5893694a956a7147948e699485fef008588a171d0dc8e003c4951",
      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "The functions are defined in the `math` module, so they must be referred to as `math.sqrt` and `math.log` in the program code."

      "source_hash": "0bbb2fdc44cddd86459319f7559426c7bb316ba5dfd73eefb27d228553dea295",
      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "Selecting distinct sections from a module"
      },
      "translation": {
        "language": "vi",

    {
      "id": "blk-part07-1-modules-0023",
      "type": "paragraph",
      "order": 23,
      "source_hash": "c729937681fd0493537494e2d900690d748845718150230a12843d96183710f7",
      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "Another way to use modules is to select a distinct entity from the module with the `from` command. In case we want to use just the functions `sqrt` and `log` from the module `math`, we can do the following:"
      },
      "translation": {
        "language": "vi",
        "content": ""
      },
      "metadata": {}
    },
    {
      "id": "blk-part07-1-modules-0024",
      "type": "code",
      "order": 24,
      "source_hash": "d45279c1925d6c3e8795277b06e8e4f69e2166a02c060815491670ed3629ecb7",
      "translation_status": "not_applicable",
      "original": {
        "language": "code",
        "content": "from math import sqrt, log\n\nprint(sqrt(5))\nprint(log(5,2))"
      },
      "translation": {
        "language": "code",
        "content": "from math import sqrt, log\n\nprint(sqrt(5))\nprint(log(5,2))"
      },
      "metadata": {
        "language": "python",
        "code_hash": "d45279c1925d6c3e8795277b06e8e4f69e2166a02c060815491670ed3629ecb7",
        "length_lines": 4
      }
    },
    {
      "id": "blk-part07-1-modules-0025",
      "type": "paragraph",
      "order": 25,
      "source_hash": "4c7134419bfe2076b0d771bfa377c7d5af5ed7790d30e8b92b9e143d78a2b598",
      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "As you can see above, we do not need the `math` prefix when using the functions imported in this manner."
      },
      "translation": {
        "language": "vi",
        "content": ""
      },
      "metadata": {}
    },
    {

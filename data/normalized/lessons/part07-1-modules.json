      "type": "paragraph",
      "order": 13,
      "source_hash": "01bff4da32f444fe4809dbeea82b31e5c3d48fe67f5acfb600bf088c8f7066dc",
      "translation_status": "pending",
      "original": {
        "language": "en",
        "content": "The command _exit_ finishes the execution of the program."
